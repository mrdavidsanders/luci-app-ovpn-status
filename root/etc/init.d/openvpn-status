#!/bin/sh /etc/rc.common

# Procd init script for luci-app-openvpn-status.
#
# Runs the status collector every $INTERVAL seconds so that
# /tmp/openvpn_new.json is always fresh for the LuCI status page.
#
# Set 'mode' in /etc/config/openvpn_status to "server" (collect from the
# local OpenVPN daemon) or "client" (fetch from a remote host over SSH).

UCI_CONFIG="openvpn_status"

get_conf() {
	uci -q get "$UCI_CONFIG.main.$1" 2>/dev/null
}

start() {
	mode=$(get_conf mode)
	interval=$(get_conf interval)
	[ -n "$interval" ] || interval=60

	case "$mode" in
		client)
			collector=/usr/bin/openvpn-client-status.sh
			;;
		*)
			collector=/usr/bin/openvpn-server-status.sh
			;;
	esac

	[ -x "$collector" ] || {
		logger -t luci-openvpn-status "collector $collector not found or not executable"
		return 1
	}

	# Run the collector in a loop, pacing it with the configured
	# interval (seconds). The collector scripts themselves run once
	# and exit, so without this loop procd would respawn them every
	# ~5s regardless of the user's setting.
	procd_open_instance "$collector"
	procd_set_param command /bin/sh -c "while :; do '$collector'; sleep '$interval'; done"
	procd_set_param respawn 1 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop() {
	:
}
